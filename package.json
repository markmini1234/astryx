{
  "name": "dsh-plugin-astryx",
  "version": "0.1.0",
  "description": "Astryx design-system bridge for DeepSeek Harness: the Neutral theme and an agent-ready Astryx workflow skill",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markmini1234/astryx.git"
  },
  "homepage": "https://github.com/markmini1234/astryx#readme",
  "bugs": {
    "url": "https://github.com/markmini1234/astryx/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./skills/*": "./skills/*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "astryx",
    "design-system",
    "theme"
  ],
  "license": "MIT",
  "icon": "./icon.svg",
  "icon-svg": "./icon.svg",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0 <5",
    "@deepseek-ai/dsh-client-ui-theme": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-skill": ">=0.2.2-rc.1 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.2-rc.1",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.1",
    "@types/node": "^24.10.0",
    "esbuild": "^0.25.12",
    "typescript": "^6.0.3"
  },
  "files": [
    "lib",
    "locale",
    "skills",
    "docs",
    "assets",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ]
}
